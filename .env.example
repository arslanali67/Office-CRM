# Copy to .env (never commit .env)
ESPOCRM_VERSION=10.0.9
CRM_DOMAIN=crm.example.com
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=espocrm
MYSQL_USER=espocrm
MYSQL_PASSWORD=change-me
ESPOCRM_ADMIN_USERNAME=admin  # must stay "admin": EspoCRM 10 image installer sets the password for "admin" only
ESPOCRM_ADMIN_PASSWORD=change-me
# Automation service (used from M3/M5)
ESPO_API_KEY=
WEBHOOK_SECRET=
WEBHOOK_SECRET_BRIEF=
WEBHOOK_SECRET_SOCIAL=
# Off-server backup (scripts/backup.sh, rclone). Example for S3-compatible storage; see the header of scripts/backup.sh. Empty = local copy only.
BACKUP_REMOTE=
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_ENDPOINT=
# Meta (Facebook/Instagram). META_VERIFY_TOKEN: any long random string you also type into the Meta app's webhook settings.
META_VERIFY_TOKEN=
# Optional: override Meta's Graph API URL (local testing uses a mock)
GRAPH_URL=
# Set AI_MODE=stub to force keyword-based fake AI (local testing). Empty = real Claude when ANTHROPIC_API_KEY is set.
AI_MODE=
ANTHROPIC_API_KEY=
META_APP_SECRET=
META_PAGE_TOKEN=
# Used by scripts/setup-m1.mjs for placeholder employee accounts
EMPLOYEE_PASSWORD=change-me
